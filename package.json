{
  "name": "marinashell",
  "version": "0.2.6",
  "description": "macOS-first SSH client with xterm.js",
  "author": "Saad Abdullah <saadqc@users.noreply.github.com>",
  "main": "main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:gui": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:plugins": "esbuild plugins/editor/renderer.source.js --bundle --minify --format=esm --platform=browser --target=chrome124 --outfile=plugins/editor/renderer.mjs && node scripts/trim-trailing-whitespace.js plugins/editor/renderer.mjs",
    "postinstall": "node node_modules/cpu-features/buildcheck.js > node_modules/cpu-features/buildcheck.gypi && electron-builder install-app-deps",
    "test:editor": "npm run build:plugins && env -u ELECTRON_RUN_AS_NODE electron scripts/editor-plugin-test.js",
    "test:ssh-config": "node scripts/ssh-config-test.js",
    "pack": "npm run build:plugins && electron-builder --dir",
    "dist": "npm run build:plugins && electron-builder",
    "test:runs": "node scripts/run-configurations-test.js",
    "test:workspace": "env -u ELECTRON_RUN_AS_NODE electron scripts/workspace-test.js",
    "test:runs:ssh": "node scripts/run-ssh-test.js",
    "test:plugin-activation": "env -u ELECTRON_RUN_AS_NODE electron scripts/plugin-activation-test.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "lucide": "^0.563.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^10.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.marinashell.app",
    "productName": "MarinaShell",
    "afterPack": "scripts/adhoc-sign-mac.js",
    "directories": {
      "output": "release/${productName}-${version}"
    },
    "files": [
      "main.js",
      "main/**",
      "plugins/**",
      "preload.js",
      "renderer/**",
      "index.html",
      "settings.html",
      "settings.js",
      "assets/**",
      "package.json",
      "node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/dock.png",
      "hardenedRuntime": false,
      "identity": null,
      "notarize": false
    },
    "dmg": {
      "title": "MarinaShell",
      "iconSize": 96,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
